<header
  class="bg-[#0a0a0a] text-white docked full-width top-0 border-b border-outline-variant z-50 sticky"
>
  <div
    class="flex justify-between items-center w-full px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto h-20"
  >
    <!-- Navigation Links (Left) -->
    <nav class="hidden md:flex items-center gap-lg">
      <a
        class="text-on-surface-variant text-label-caps font-label-caps hover:text-white transition-colors duration-200"
        href="#">Colecciones</a
      >
      <a
        class="text-on-surface-variant text-label-caps font-label-caps hover:text-white transition-colors duration-200"
        href="#">Novedades</a
      >
      <a
        class="text-on-surface-variant text-label-caps font-label-caps hover:text-white transition-colors duration-200"
        href="#">Archivo</a
      >
    </nav>

    <!-- Brand Logo (Center) -->
    <div class="flex-1 flex md:justify-center">
      <a
        class="text-headline-md font-headline-md tracking-tighter text-white"
        href="#">LUXE STEP</a
      >
    </div>

    <!-- Trailing Icons (Right) -->
    <div class="flex items-center gap-md justify-end">
      <button
        class="text-on-surface-variant hover:text-white transition-colors duration-200"
      >
        <span
          class="material-symbols-outlined text-headline-sm font-headline-sm"
          >shopping_bag</span
        >
      </button>
      <button
        class="text-on-surface-variant hover:text-white transition-colors duration-200"
      >
        <span
          class="material-symbols-outlined text-headline-sm font-headline-sm"
          >person</span
        >
      </button>
    </div>
  </div>
</header>
