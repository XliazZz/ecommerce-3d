<header
  class="bg-[#0a0a0a] text-white border-b border-outline-variant z-50 sticky top-0"
>
  <div
    class="flex md:grid md:grid-cols-3 items-center w-full px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto h-20"
  >
    <!-- Navigation (Left) -->
    <nav class="hidden md:flex items-center gap-lg justify-start">
      <a
        class="text-on-surface-variant text-label-caps font-label-caps hover:text-white transition-colors duration-200 py-3"
        href="/collection">Colecciones</a
      >
      <a
        class="text-on-surface-variant text-label-caps font-label-caps hover:text-white transition-colors duration-200 py-3"
        href="#">Novedades</a
      >
      <a
        class="text-on-surface-variant text-label-caps font-label-caps hover:text-white transition-colors duration-200 py-3"
        href="#">Archivo</a
      >
    </nav>

    <!-- Logo (Center) -->
    <div class="flex justify-center col-start-2 md:col-start-2">
      <a
        class="text-headline-md font-headline-md tracking-tighter text-white py-3"
        href="/">LUXE STEP</a
      >
    </div>

    <!-- Icons (Right) -->
    <div
      class="flex items-center gap-md justify-end col-start-3 md:col-start-3"
    >
      <button
        class="text-on-surface-variant hover:text-white transition-colors duration-200 py-3 cursor-pointer"
      >
        <span
          class="material-symbols-outlined text-headline-sm font-headline-sm"
          >shopping_bag</span
        >
      </button>
      <button
        class="text-on-surface-variant hover:text-white transition-colors duration-200 py-3 cursor-pointer"
      >
        <span
          class="material-symbols-outlined text-headline-sm font-headline-sm"
          >person</span
        >
      </button>
    </div>
  </div>
</header>
