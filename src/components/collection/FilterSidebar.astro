<aside
  class="hidden md:flex bg-surface-container-lowest border-r border-outline-variant shadow-sm fixed left-0 top-20 h-[calc(100vh-80px)] w-80 flex-col p-lg z-40 overflow-y-auto custom-scrollbar"
>
  <!-- Category Navigation -->
  <div class="mb-xl">
    <div
      class="flex justify-between items-end mb-lg border-b border-outline-variant pb-sm"
    >
      <div>
        <h2 class="text-headline-sm font-headline-sm text-primary">Filtros</h2>
        <p class="text-detail-sm font-detail-sm text-on-surface-variant mt-xs">
          Refina tu busqueda
        </p>
      </div>
      <button
        class="text-label-caps font-label-caps text-on-surface-variant hover:text-primary transition-colors"
        >Limpiar todo</button
      >
    </div>
    <nav class="flex flex-col gap-sm">
      <a
        class="flex items-center gap-md py-sm px-md rounded text-primary font-bold bg-surface-container-high translate-x-1 hover:bg-surface-container transition-all duration-200"
        href="#"
      >
        <span class="material-symbols-outlined text-[20px]">grid_view</span>
        <span class="text-label-caps font-label-caps">Todos los zapatos</span>
      </a>
      <a
        class="flex items-center gap-md py-sm px-md rounded text-on-surface-variant hover:bg-surface-container hover:text-primary transition-all duration-200"
        href="#"
      >
        <span class="text-[20px]">👟</span>
        <span class="text-label-caps font-label-caps">Rendimiento</span>
      </a>
      <a
        class="flex items-center gap-md py-sm px-md rounded text-on-surface-variant hover:bg-surface-container hover:text-primary transition-all duration-200"
        href="#"
      >
        <span class="text-[20px]">👡</span>
        <span class="text-label-caps font-label-caps">Sandalia</span>
      </a>
      <a
        class="flex items-center gap-md py-sm px-md rounded text-on-surface-variant hover:bg-surface-container hover:text-primary transition-all duration-200"
        href="#"
      >
        <span class="text-[20px]">👞</span>
        <span class="text-label-caps font-label-caps">Formal</span>
      </a>
    </nav>
  </div>

  <!-- Product Filters (Size, Color, Price) -->
  <div class="flex flex-col gap-lg border-t border-outline-variant pt-lg">
    <!-- Size -->
    <details class="group" open>
      <summary
        class="flex justify-between items-center cursor-pointer list-none text-label-caps font-label-caps text-primary uppercase tracking-wider"
      >
        Tallas
        <span
          class="material-symbols-outlined transition-transform group-open:rotate-180"
          >expand_more</span
        >
      </summary>
      <div class="grid grid-cols-3 gap-sm mt-md">
        <button
          class="py-sm border border-outline-variant rounded text-detail-sm font-detail-sm text-on-surface-variant hover:border-primary hover:text-primary transition-colors bg-surface-container-lowest"
          >37</button
        >
        <button
          class="py-sm border border-primary rounded text-detail-sm font-detail-sm text-primary bg-surface-container transition-colors"
          >38</button
        >
        <button
          class="py-sm border border-outline-variant rounded text-detail-sm font-detail-sm text-on-surface-variant hover:border-primary hover:text-primary transition-colors bg-surface-container-lowest"
          >39</button
        >
        <button
          class="py-sm border border-outline-variant rounded text-detail-sm font-detail-sm text-on-surface-variant hover:border-primary hover:text-primary transition-colors bg-surface-container-lowest"
          >40</button
        >
        <button
          class="py-sm border border-outline-variant rounded text-detail-sm font-detail-sm text-on-surface-variant hover:border-primary hover:text-primary transition-colors bg-surface-container-lowest"
          >41</button
        >
        <button
          class="py-sm border border-outline-variant rounded text-detail-sm font-detail-sm text-on-surface-variant opacity-50 cursor-not-allowed bg-surface-container-lowest"
          >42</button
        >
      </div>
    </details>

    <!-- Color -->
    <details class="group" open>
      <summary
        class="flex justify-between items-center cursor-pointer list-none text-label-caps font-label-caps text-primary uppercase tracking-wider"
      >
        Color
        <span
          class="material-symbols-outlined transition-transform group-open:rotate-180"
          >expand_more</span
        >
      </summary>
      <div class="flex flex-col gap-sm mt-md">
        <label class="flex items-center gap-md cursor-pointer group/label">
          <input class="peer sr-only" type="checkbox" />
          <div
            class="w-4 h-4 border border-outline-variant rounded-sm flex items-center justify-center bg-surface-container-lowest peer-checked:bg-primary peer-checked:border-primary transition-colors"
          >
            <span
              class="material-symbols-outlined text-[12px] text-background opacity-0 peer-checked:opacity-100 font-bold"
              >check</span
            >
          </div>
          <span
            class="w-3 h-3 rounded-full bg-black border border-outline-variant"
          ></span>
          <span
            class="text-body-md font-body-md text-on-surface-variant group-hover/label:text-primary transition-colors"
            >Negro</span
          >
        </label>
        <label class="flex items-center gap-md cursor-pointer group/label">
          <input checked class="peer sr-only" type="checkbox" />
          <div
            class="w-4 h-4 border border-outline-variant rounded-sm flex items-center justify-center bg-surface-container-lowest peer-checked:bg-primary peer-checked:border-primary transition-colors"
          >
            <span
              class="material-symbols-outlined text-[12px] text-background opacity-0 peer-checked:opacity-100 font-bold"
              >check</span
            >
          </div>
          <span
            class="w-3 h-3 rounded-full bg-[#f3f4f6] border border-outline-variant"
          ></span>
          <span
            class="text-body-md font-body-md text-on-surface-variant group-hover/label:text-primary transition-colors"
            >Blanco</span
          >
        </label>
        <label class="flex items-center gap-md cursor-pointer group/label">
          <input class="peer sr-only" type="checkbox" />
          <div
            class="w-4 h-4 border border-outline-variant rounded-sm flex items-center justify-center bg-surface-container-lowest peer-checked:bg-primary peer-checked:border-primary transition-colors"
          >
            <span
              class="material-symbols-outlined text-[12px] text-background opacity-0 peer-checked:opacity-100 font-bold"
              >check</span
            >
          </div>
          <span
            class="w-3 h-3 rounded-full bg-[#4a4a4a] border border-outline-variant"
          ></span>
          <span
            class="text-body-md font-body-md text-on-surface-variant group-hover/label:text-primary transition-colors"
            >Gris</span
          >
        </label>
      </div>
    </details>

    <!-- Price -->
    <details class="group" open>
      <summary
        class="flex justify-between items-center cursor-pointer list-none text-label-caps font-label-caps text-primary uppercase tracking-wider"
      >
        Precio
        <span
          class="material-symbols-outlined transition-transform group-open:rotate-180"
          >expand_more</span
        >
      </summary>
      <div class="mt-md flex flex-col gap-md">
        <div class="relative h-1 bg-surface-container rounded-full w-full">
          <div
            class="absolute h-full bg-primary left-1/4 right-1/4 rounded-full"
          >
          </div>
          <div
            class="absolute w-4 h-4 bg-primary rounded-full top-1/2 -translate-y-1/2 left-1/4 -translate-x-1/2 shadow-sm cursor-pointer border border-background"
          >
          </div>
          <div
            class="absolute w-4 h-4 bg-primary rounded-full top-1/2 -translate-y-1/2 right-1/4 translate-x-1/2 shadow-sm cursor-pointer border border-background"
          >
          </div>
        </div>
        <div
          class="flex justify-between text-detail-sm font-detail-sm text-on-surface-variant mt-sm"
        >
          <div
            class="bg-surface-container-lowest border border-outline-variant px-sm py-xs rounded"
          >
            $150.000
          </div>
          <div
            class="bg-surface-container-lowest border border-outline-variant px-sm py-xs rounded"
          >
            $350.000
          </div>
        </div>
      </div>
    </details>
  </div>
</aside>
