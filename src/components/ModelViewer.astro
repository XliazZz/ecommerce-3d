---
export interface Props {
  modelUrl: string;
  altText?: string;
}

const { modelUrl, altText = "Modelo 3D" } = Astro.props;
---

<!-- Importar el script custom element de model-viewer -->
<script>
  import "@google/model-viewer";
</script>

<div class="viewer-container">
  <model-viewer
    src={modelUrl}
    alt={altText}
    auto-rotate
    camera-controls
    ar
    shadow-intensity="1"
    style="width: 100%; height: 400px; background-color: #1a1a1a;"
  >
    <button slot="ar-button" style="background: white; border-radius: 4px; border: none; padding: 8px 16px; position: absolute; bottom: 16px; right: 16px;">
      Ver en tu espacio (AR)
    </button>
  </model-viewer>
</div>